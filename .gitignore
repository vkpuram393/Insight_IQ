certs/
*.cer
*.crt
*.pem
*.p12
*.pfx

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Cache directories
.cache/

# MyPy / type checking
.mypy_cache/
.dmypy.json

# Ruff / lint caches
.ruff_cache/

# Profiling data
.prof

# Generated documentation
site/

# Coverage XML/Reports
coverage.xml

# Ignore local tooling state
copilot-*.json
