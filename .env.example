# CVS Root Certificate Configuration
# Point these to the CVS root certificate to handle SSL/TLS through Zscaler proxy
SSL_CERT_FILE=certs/CVSHealthRoot.cer
REQUESTS_CA_BUNDLE=certs/CVSHealthRoot.cer

# LangGraph / LangChain settings
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Claims History Search API
# Subscription key for the internal claims-search gateway (overrides any x-api-key from the UI)
# Required for local dev — in deployed envs this is set via CLAIMS_HISTORY_SEARCH_X_API_KEY in the environment's v1.yaml
CLAIMS_HISTORY_SEARCH_X_API_KEY=

# Application settings
USE_MOCK_LLM=True
ENABLE_CHECKPOINTING=False
CONFIDENCE_THRESHOLD=0.7
ENABLE_SEMANTIC_CACHE=True

